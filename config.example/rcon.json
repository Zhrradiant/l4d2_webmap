// RCON 密码配置
// mode:
//   "unified"  - 所有端口共用一个密码
//   "per_port" - 按端口各自配置密码

// ===== 模式一：全服统一密码 =====
{
  "mode": "unified",
  "unified_password": "你的RCON密码",
  "per_port": {},
  "host_override": {}
}

// ===== 模式二：每端口各自密码 =====
